# <type>(<scope>): <subject>
# |<----  Using a Max Of 72 Characters ---->|

# type: feat | fix | docs | style | refactor | perf | test | build | ci | chore | revert
# scope: optional ticket id, module, or area (e.g. parsers, render, db, api)

# subject: imperative, lowercase, no trailing period, <= 72 chars
# body: optional, explain the "what" and "why"

# Examples:
#   feat(parsers): add CodeBuddy Code session format
#   fix(render): escape model name in session badge
#   docs(readme): document conventional commits
#   chore: bump Bun to 1.3.14

# BREAKING CHANGE: <description>  (append to footer when the change breaks API)
# Closes #123                     (reference an issue)
